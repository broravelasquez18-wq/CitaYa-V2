# ── Variables de entorno · CitaYa V2 ─────────────────────────
# En Dokploy: pégalas en la pestaña "Environment" del proyecto.

# Dominio público (sin http://). Debe apuntar por DNS a este VPS.
DOMAIN=citayav2.tudominio.com

# Clave de aplicación: 64 caracteres hex. Genera una con:
#   openssl rand -hex 32
# Si la dejas vacía, se genera y persiste en el volumen de storage.
APP_KEY=

# ── Base de datos (MariaDB del propio stack) ─────────────────
DB_NAME=citaya
DB_USER=citaya
DB_PASS=cambia_esta_password
DB_ROOT_PASS=cambia_esta_password_root

# ── Correo ───────────────────────────────────────────────────
# 'local' = prepara los correos en la Bandeja local, sin enviar a Internet.
# 'smtp'  = envía de verdad (requiere las credenciales de abajo).
MAIL_TRANSPORT=local
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tucorreo@gmail.com
MAIL_PASSWORD=tu_app_password_de_google
MAIL_FROM=tucorreo@gmail.com
